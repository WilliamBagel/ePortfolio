 ramp between two wall blue values\n              vec3 colorA = vec3(0.45, 0.56, 0.91); // #7390e8 (lighter blue)\n              vec3 colorB = vec3(0.43, 0.5, 0.85); // #4761ad (darker blue)\n\n              float rand(float n){return fract(sin(n) * 43758.5453123);}\n              float rand(vec2 n) { \n                return fract(sin(dot(n, vec2(12.9898, 4.1414))) * 43758.5453);\n              }\n              float noise(float p){\n                float fl = floor(p);\n                float fc = fract(p);\n                return mix(rand(fl), rand(fl + 1.0), fc);\n              }\n              float noise(vec2 n) {\n                const vec2 d = vec2(0.0, 1.0);\n                vec2 b = floor(n), f = smoothstep(vec2(0.0), vec2(1.0), fract(n));\n                return mix(mix(rand(b), rand(b + d.yx), f.x), mix(rand(b + d.xy), rand(b + d.yy), f.x), f.y);\n              }\n              float mod289(float x){return x - floor(x * (1.0 / 289.0)) * 289.0;}\n              vec4 mod289(vec4 x){return x - floor(x * (1.0 / 289.0)) * 289.0;}\n              vec4 perm(vec4 x){return mod289(((x * 34.0) + 1.0) * x);}\n              float noise(vec3 p){\n                  vec3 a = floor(p);\n                  vec3 d = p - a;\n                  d = d * d * (3.0 - 2.0 * d);\n\n                  vec4 b = a.xxyy + vec4(0.0, 1.0, 0.0, 1.0);\n                  vec4 k1 = perm(b.xyxy);\n                  vec4 k2 = perm(k1.xyxy + b.zzww);\n\n                  vec4 c = k2 + a.zzzz;\n                  vec4 k3 = perm(c);\n                  vec4 k4 = perm(c + 1.0);\n\n                  vec4 o1 = fract(k3 * (1.0 / 41.0));\n                  vec4 o2 = fract(k4 * (1.0 / 41.0));\n\n                  vec4 o3 = o2 * d.z + o1 * (1.0 - d.z);\n                  vec2 o4 = o3.yw * d.x + o3.xz * (1.0 - d.x);\n\n                  return o4.y * d.y + o4.x * (1.0 - d.y);\n              }\n\n              // Bump to normal (Blender style)\n              vec3 bumpToNormal(vec3 pos, float scale, float strength) {\n                float eps = 0.001;\n                float h = noise(pos * scale);\n                float hx = noise((pos + vec3(eps, 0.0, 0.0)) * scale);\n                float hy = noise((pos + vec3(0.0, eps, 0.0)) * scale);\n                // Derivatives\n                float dx = (hx - h) / eps;\n                float dy = (hy - h) / eps;\n                // Normal in tangent space\n                vec3 n = normalize(vec3(-dx * strength, -dy * strength, 1.0));\n                return n;\n              }\n\n              // Remap noise to [low, 1.0] like a color ramp\n              float remapNoise(float n, float low) {\n                return clamp((n - low) / (1.0 - low), 0.0, 1.0);\n              }\n\n              void main( ) {\n                vec3 pos = vec3(worldPosition.x, worldPosition.y, worldPosition.z);\n                float n = noise(pos * scale);\n                float noiseValue = remapNoise(n, 0.9); // 0.35 = lower percent, tweak as needed\n\n                // Use noiseValue as the t for color ramp\n                vec3 color = mix(colorA, colorB, noiseValue);\n\n                // Compute normal from bump (height = noiseValue)\n                vec3 normal = bumpToNormal(pos, scale, bumpStrength);\n\n                // Simple lighting with perturbed normal\n                vec3 lightDir = normalize(vec3(0.3, 0.7, 1.0));\n                float diffuse = max(dot(normal * 0.5, lightDir), 0.0);\n\n                gl_FragColor = vec4(color * (0.7 + 0.3 * diffuse), 1.0 );\n              }\n            "}}},"three_textures":{"main_floor*":{"repeat":[2,2],"wrapS":"RepeatWrapping","wrapT":"RepeatWrapping"},"wall_seamless_blue*":{"repeat":[30,30],"wrapS":"RepeatWrapping","wrapT":"RepeatWrapping"}},"cannon":{"default":{"type":"Material","settings":{"friction":1}},"character":{"type":"Material","settings":{"friction":1,"restitution":0}},"elevator_floor":{"type":"Material","settings":{"friction":1,"restitution":0.1}}}},"objects":{"list":[{"isconnect